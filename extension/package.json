{
  "name": "private-proxy-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private Proxy - Chromium MV3 extension (UI) for the Xray-based native runtime",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --release",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "playwright-core": "^1.63.0",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "jsqr": "^1.4.0"
  }
}
